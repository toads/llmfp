<mxfile host="drawio" version="30.3.14">
  <diagram id="llmfp-tool-attribution" name="Tool attribution flow">
    <mxGraphModel dx="1520" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="2" value="llmfp tool-layer attribution: from hosted web tool to evidence" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="3" value="The callback identifies observed web-tool infrastructure. It does not authenticate the generation model." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="180" y="60" width="1160" height="30" as="geometry" />
        </mxCell>

        <mxCell id="10" value="1  Local probe setup" style="swimlane;startSize=36;rounded=1;html=1;fontStyle=1;fontSize=15;fillColor=#eef5ff;strokeColor=#6c8ebf;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="260" height="500" as="geometry" />
        </mxCell>
        <mxCell id="11" value="llmfp CLI&#xa;&#xa;Creates a random OAST host + exact path&#xa;Selects API adapter and model claim" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="10">
          <mxGeometry x="30" y="70" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="12" value="JSON / text report&#xa;&#xa;Registry URL + hash&#xa;Observed IP + path + UA&#xa;Independent tool verdict" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="10">
          <mxGeometry x="30" y="330" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="20" value="2  API and hosted-tool execution" style="swimlane;startSize=36;rounded=1;html=1;fontStyle=1;fontSize=15;fillColor=#fff7ed;strokeColor=#d79b00;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="110" width="520" height="500" as="geometry" />
        </mxCell>
        <mxCell id="21" value="API endpoint / relay&#xa;&#xa;POST /v1/responses&#xa;or /v1/messages" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="20">
          <mxGeometry x="30" y="70" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="22" value="Generation model&#xa;&#xa;Claimed identity is unverified&#xa;Model may choose whether to use a tool" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="20">
          <mxGeometry x="290" y="70" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="23" value="Hosted web tool&#xa;&#xa;OpenAI: web_search&#xa;Anthropic: web_fetch&#xa;&#xa;Search/open/fetch behavior is provider-controlled" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="20">
          <mxGeometry x="160" y="250" width="230" height="140" as="geometry" />
        </mxCell>
        <mxCell id="24" value="No tool call, URL blocked, cached/indexed result, or timeout&#xa;→ no_callback is inconclusive" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="20">
          <mxGeometry x="100" y="420" width="350" height="60" as="geometry" />
        </mxCell>

        <mxCell id="30" value="3  External observation" style="swimlane;startSize=36;rounded=1;html=1;fontStyle=1;fontSize=15;fillColor=#f9fafb;strokeColor=#666666;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="880" y="110" width="260" height="500" as="geometry" />
        </mxCell>
        <mxCell id="31" value="OAST / Interactsh&#xa;&#xa;Receives DNS and HTTP callbacks&#xa;Records remote IP, exact path, headers, timestamp&#xa;Returns encrypted session events" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;dashed=1;" vertex="1" parent="30">
          <mxGeometry x="30" y="245" width="200" height="150" as="geometry" />
        </mxCell>

        <mxCell id="40" value="4  Evidence matching" style="swimlane;startSize=36;rounded=1;html=1;fontStyle=1;fontSize=15;fillColor=#f0fdf4;strokeColor=#82b366;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1170" y="110" width="310" height="500" as="geometry" />
        </mxCell>
        <mxCell id="41" value="Provider-published registries&#xa;&#xa;OpenAI bot/tool JSON CIDRs&#xa;Anthropic outbound-tool CIDR&#xa;&#xa;Fetched live and SHA-256 recorded" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" vertex="1" parent="40">
          <mxGeometry x="40" y="55" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="42" value="Local matcher&#xa;&#xa;Exact random path?&#xa;HTTP source IP in official CIDR?&#xa;User-Agent only as weak evidence" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="40">
          <mxGeometry x="40" y="215" width="230" height="120" as="geometry" />
        </mxCell>
        <mxCell id="43" value="Tool attribution verdict&#xa;&#xa;attributed / likely / dns_only&#xa;unattributed / no_callback&#xa;&#xa;Model attribution: unknown" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="40">
          <mxGeometry x="40" y="375" width="230" height="105" as="geometry" />
        </mxCell>

        <mxCell id="50" value="Important boundary: an API endpoint sees the probe URL and can fetch it directly, or invoke a genuine third-party tool independently of the model used for generation. Even an official CIDR match is tool-layer evidence, not proof of model identity." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
